name:               skiletro
version:            0.1.0.0
build-type:         Simple
cabal-version:      >= 1.10

executable site
  main-is:          site.hs
  build-depends:    base == 4.*
                  , filepath
                  , hakyll == 4.16.*
                  , hakyll-sass == 0.2.*
                  , template-haskell == 2.21.*
                  , process == 1.6.25.*
  ghc-options:      -threaded -rtsopts -with-rtsopts=-N
  default-language: Haskell2010
